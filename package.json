    "start": "electron-forge start",
    "web:dev": "pnpm --filter @hanoki/web dev",
    "web:build": "pnpm --filter @hanoki/web build",
    "web:preview": "pnpm --filter @hanoki/web preview",
    "web:test": "pnpm --filter @hanoki/web test",
    "web:deploy": "pnpm --filter @hanoki/web deploy",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release:publish": "electron-forge publish",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
