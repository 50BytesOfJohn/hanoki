  "scripts": {
    "start": "electron-forge start",
    "web:dev": "pnpm --filter @hanoki/web dev",
    "web:build": "pnpm --filter @hanoki/web build",
    "web:preview": "pnpm --filter @hanoki/web preview",
    "web:test": "pnpm --filter @hanoki/web test",
    "web:deploy": "pnpm --filter @hanoki/web deploy",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release:publish": "electron-forge publish",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "seed:chat-tree": "node ./scripts/seed-chat-tree.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm fmt:check && pnpm lint",
    "fix": "pnpm fmt && pnpm lint:fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ."
  },
